# ─────────────────────────────────────────────────────────────────────────────
# Nepal Poultry & Livestock International Expo — environment variables
# Copy to .env.local for development. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are visible in the browser; all others stay on the server.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (no trailing slash). Used for canonical URLs, sitemap, e-mails.
NEXT_PUBLIC_SITE_URL=https://www.nepalpoultryexpo.com

# ── MongoDB Atlas (required — primary store for every submission) ───────────
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://web_db_user:rw9mnLs4TL1rqrAq@cluster0.liyveo9.mongodb.net/
MONGODB_DB_NAME=nepal_poultry_expo
web_db_user
rw9mnLs4TL1rqrAq
# ── Google reCAPTCHA v2 "I'm not a robot" checkbox (required) ───────────────
# Create a v2 Checkbox key at https://www.google.com/recaptcha/admin and add your domains.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LfkJDAuAAAAALsi53xcaurXmbE_7LPpjh11wfUI
RECAPTCHA_SECRET_KEY=6LfkJDAuAAAAAEGXo6e6LBJbG3f_L7-bpQwfLpGj

# ── Google Sheets (every form → one sheet, tab "Website Enquiries") ─────────
# Base64 of the full service-account JSON key, e.g. on macOS/Linux:  base64 -w0 key.json
# PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
# Share the spreadsheet with the service account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_
GOOGLE_SHEET_ID=
# Optional — defaults to "Website Enquiries"
GOOGLE_SHEET_TAB=Website Enquiries

# ── E-mail via Gmail SMTP (Nodemailer) ──────────────────────────────────────
# GMAIL_APP_PASSWORD is a 16-character Google App Password (2-Step Verification required).
GMAIL_USER=web@futurexpr.com
GMAIL_APP_PASSWORD=tzbgkucjwjilualg
# Optional sender display name
EMAIL_FROM_NAME=Nepal Poultry & Livestock International Expo
# Both receive every submission notification.
EMAIL_TO_PRIMARY=admin@futurextrade.com
EMAIL_TO_SECONDARY=info@futurextrade.com

# ── Outbox worker / cron ─────────────────────────────────────────────────────
# Long random string. Protects /api/cron/outbox and signs brochure download links.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Optional separate key for brochure links (falls back to CRON_SECRET)
BROCHURE_LINK_SECRET=
# Optional salt for hashed IP addresses (falls back to CRON_SECRET)
IP_HASH_SALT=

# VPS worker only (npm run worker): where the Next.js server listens, and poll interval.
OUTBOX_WORKER_URL=http://127.0.0.1:3000
OUTBOX_INTERVAL_SECONDS=30

# ── Brochure ────────────────────────────────────────────────────────────────
# File name inside private/brochure/ (never put the brochure in /public).
BROCHURE_FILE_NAME=nepal-poultry-expo-brochure.pdf

# ── Public contact details (optional — shown only when set) ─────────────────
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
