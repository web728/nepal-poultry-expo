{
  "name": "nepal-poultry-expo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "next build",
    "images:manifest": "node scripts/generate-image-manifest.mjs",
    "predev": "npm run images:manifest",
    "dev": "next dev",
    "dev:db": "node scripts/dev-mongo.mjs",
    "prebuild": "npm run images:manifest",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker": "node --env-file-if-exists=.env.local scripts/outbox-worker.mjs",
    "outbox:status": "node --env-file-if-exists=.env.local scripts/outbox-admin.mjs status",
    "outbox:retry-dead": "node --env-file-if-exists=.env.local scripts/outbox-admin.mjs retry-dead",
    "email:preview": "vitest run tests/templates-and-rows.test.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.77.0",
    "mongodb": "^7.9.1",
    "next": "16.4.6",
    "nodemailer": "^10.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  }
}
